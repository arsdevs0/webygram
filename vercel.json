{
  "$schema": "https://openapi.vercel.co/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/|assets/|telegram-sw.js$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [{ "source": "/telegram-sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }, { "key": "Service-Worker-Allowed", "value": "/" }] }]
}
