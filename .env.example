# Vercel/browser build: optional Telegram application credentials.
# Built-in defaults are used when empty. Get your own at https://my.telegram.org.
# VITE_* values are public in the browser bundle. Never put a user session,
# login code, password, bot token or other private credential in a VITE_* variable.
VITE_TELEGRAM_API_ID=
VITE_TELEGRAM_API_HASH=

# Optional legacy local Node mode only; not needed by Vercel.
PORT=3000
DATA_DIR=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
